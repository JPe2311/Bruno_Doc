rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() { return request.auth != null; }
    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists ? userDoc.data.role : 'PACIENTE';
    }
    function isAdmin() { return getRole() == 'MEDICO'; }
    function isSecretary() { return getRole() == 'SECRETARIA'; }
    function isPatient() { return getRole() == 'PACIENTE'; }

    match /users/{uid} {
      allow read, write: if isLoggedIn() && request.auth.uid == uid;
    }

    match /patients/{uid} {
      allow read: if isAdmin() || isSecretary() || request.auth.uid == uid;
      allow write: if isAdmin() || request.auth.uid == uid;
    }

    match /medical_records/{id} {
      allow read, write: if isAdmin();
    }

    match /appointments/{id} {
      allow read: if isAdmin() || isSecretary() || request.auth.uid == resource.data.patientUid;
      allow create: if isAdmin() || isSecretary() || (isPatient() && request.auth.uid == request.resource.data.patientUid);
      allow update: if isAdmin() || isSecretary() || request.auth.uid == resource.data.patientUid;
      allow delete: if isAdmin();
    }

    match /slots/{slotId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if isAdmin() || isSecretary() || request.auth.uid == resource.data.patientUid;
    }

    match /schedules/{doctorUid} {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || request.auth.uid == doctorUid;
    }

    match /casos/{caseId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.patientUid;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /catalog_tables/{id} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
