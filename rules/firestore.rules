rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMedico() {
      return isSignedIn() && userRole() == 'MEDICO';
    }

    function isSecretaria() {
      return isSignedIn() && userRole() == 'SECRETARIA';
    }

    function isMedicoOrSecretaria() {
      return isMedico() || isSecretaria();
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    // - Each user reads/writes their own profile
    // - MEDICO / SECRETARIA can read any user (to look up patients)
    // - Role field is IMMUTABLE from the client (cannot be changed by the user)

    match /users/{uid} {
      allow read: if isOwner(uid) || isMedicoOrSecretaria();
      allow create: if isOwner(uid) && request.resource.data.role == 'PACIENTE';
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // ── CASOS (Clinical Cases) ────────────────────────────────────────────────
    // - MEDICO: full CRUD
    // - SECRETARIA: read + create (no clinical edits, no delete)
    // - PACIENTE: read their own cases only

    match /casos/{caseId} {
      allow read: if isMedico()
        || isSecretaria()
        || (isSignedIn() && resource.data.patientUid == request.auth.uid);
      allow create: if isMedicoOrSecretaria();
      allow update: if isMedico();
      allow delete: if isMedico();
    }

    // ── MEDICAL RECORDS ───────────────────────────────────────────────────────
    // - MEDICO: full CRUD
    // - PACIENTE: read their own

    match /medical_records/{id} {
      allow read: if isMedico()
        || (isSignedIn() && resource.data.patientUid == request.auth.uid);
      allow create, update: if isMedico();
      allow delete: if isMedico();
    }

    // ── APPOINTMENTS ──────────────────────────────────────────────────────────
    // - MEDICO / SECRETARIA: full read + manage
    // - PACIENTE: read + create their own; cannot update/delete

    match /appointments/{id} {
      allow read: if isMedicoOrSecretaria()
        || (isSignedIn() && resource.data.patientUid == request.auth.uid);
      allow create: if isSignedIn() && (
        isMedicoOrSecretaria()
        || request.resource.data.patientUid == request.auth.uid
      );
      allow update: if isMedicoOrSecretaria();
      allow delete: if isMedico();
    }

    // ── SLOTS ─────────────────────────────────────────────────────────────────

    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create, update: if isMedicoOrSecretaria();
      allow delete: if isMedico();
    }

    // ── SCHEDULES ─────────────────────────────────────────────────────────────
    // Only the owning doctor can write their own schedule

    match /schedules/{doctorUid} {
      allow read: if isSignedIn();
      allow write: if isMedico() && request.auth.uid == doctorUid;
    }

    // ── CATALOG TABLES ────────────────────────────────────────────────────────

    match /catalog_tables/{id} {
      allow read: if isSignedIn();
      allow write: if isMedico();
    }

    // ── AUDIT LOGS ────────────────────────────────────────────────────────────
    // - Any authenticated user can CREATE their own log entry
    // - Only MEDICO can READ audit logs
    // - Nobody can UPDATE or DELETE (immutable)

    match /audit_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isMedico();
      allow update, delete: if false;
    }
  }
}
