rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // USERS - Allow authenticated users to read/write their own profile
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // CASOS - Allow any authenticated user to create/read/update/delete
    match /casos/{caseId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // MEDICAL RECORDS
    match /medical_records/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    // APPOINTMENTS
    match /appointments/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    // SLOTS
    match /slots/{slotId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // SCHEDULES
    match /schedules/{doctorUid} {
      allow read, write: if isSignedIn();
    }

    // CATALOG TABLES
    match /catalog_tables/{id} {
      allow read, write: if isSignedIn();
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}