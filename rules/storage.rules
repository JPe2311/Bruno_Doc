rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User files: stamp, banner, profile photo
    // - Only the owner can write to their own folder
    // - Max 5 MB, images only
    // - All authenticated users can read (needed for report rendering)
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
